# Public browser configuration for your Supabase project.
# Copy to .env.local and replace these placeholders before building.
# Never use a secret key, service_role key, database password, or SMTP password.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
